","저장 폴더 생성 완료\n","준비 완료!\n"]}]},{"cell_type":"code","metadata":{"id":"af729e93","executionInfo":{"status":"ok","timestamp":1781072339778,"user_tz":-540,"elapsed":47,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"5b0a51a9-f2a7-4bc8-be68-de044748b9ef"},"source":["# =====================================================\n","# 코드 12 : Random Search 필수 함수/클래스 통합본\n","# 런타임 초기화 후 이 셀만 다시 실행하면 됨\n","# =====================================================\n","\n","import os\n","import gc\n","import random\n","import numpy as np\n","import pandas as pd\n","import librosa\n","\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","# -----------------------------------------------------\n","# 기본 경로\n","# -----------------------------------------------------\n","\n","SAVE_ROOT = \"/content/drive/MyDrive/DeepShip_Results\"\n","MODEL_DIR = f\"{SAVE_ROOT}/models\"\n","CSV_DIR = f\"{SAVE_ROOT}/csv\"\n","CHECKPOINT_DIR = f\"{SAVE_ROOT}/checkpoints\"\n","\n","os.makedirs(SAVE_ROOT, exist_ok=True)\n","os.makedirs(MODEL_DIR, exist_ok=True)\n","os.makedirs(CSV_DIR, exist_ok=True)\n","os.makedirs(CHECKPOINT_DIR, exist_ok=True)\n","\n","BASE_PATH = \"/content/deepship/DeepShip-main\"\n","CLASSES = [\"Cargo\", \"Passengership\", \"Tanker\", \"Tug\"]\n","SAMPLE_RATE = 22050\n","\n","# -----------------------------------------------------\n","# 데이터 증강 함수\n","# -----------------------------------------------------\n","\n","def add_noise(y, noise_level=0.005):\n","    noise = np.random.randn(len(y))\n","    return y + noise_level * noise\n","\n","\n","def time_stretch(y, rate=1.1):\n","    return librosa.effects.time_stretch(y=y, rate=rate)\n","\n","\n","def pitch_shift(y, sr, n_steps=2):\n","    return librosa.effects.pitch_shift(y=y, sr=sr, n_steps=n_steps)\n","\n","\n","def fix_length(y, target_length):\n","    if len(y) > target_length:\n","        return y[:target_length]\n","    return np.pad(y, (0, target_length - len(y)))\n","\n","\n","# -----------------------------------------------------\n","# Mel Spectrogram 함수\n","# -----------------------------------------------------\n","\n","def make_mel(y, sr, n_mels, n_fft, hop_length):\n","    mel = librosa.feature.melspectrogram(\n","        y=y,\n","        sr=sr,\n","        n_mels=n_mels,\n","        n_fft=n_fft,\n","        hop_length=hop_length\n","    )\n","\n","    mel_db = librosa.power_to_db(mel, ref=np.max)\n","\n","    return mel_db\n","\n","\n","# -----------------------------------------------------\n","# Dataset 클래스\n","# -----------------------------------------------------\n","\n","class ShipDataset(Dataset):\n","\n","    def __init__(self, X, y):\n","        self.X = torch.FloatTensor(X).unsqueeze(1)\n","        self.y = torch.LongTensor(y)\n","\n","    def __len__(self):\n","        return len(self.X)\n","\n","    def __getitem__(self, idx):\n","        return self.X[idx], self.y[idx]\n","\n","\n","# -----------------------------------------------------\n","# CNN 모델\n","# -----------------------------------------------------\n","\n","class ShipCNN(nn.Module):\n","\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.features = nn.Sequential(\n","            nn.Conv2d(1, 32, 3, padding=1),\n","            nn.BatchNorm2d(32),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.2),\n","\n","            nn.Conv2d(32, 64, 3, padding=1),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3),\n","\n","            nn.Conv2d(64, 128, 3, padding=1),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3)\n","        )\n","\n","        self.pool = nn.AdaptiveAvgPool2d((4, 4))\n","\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(128 * 4 * 4, 256),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(256, len(CLASSES))\n","        )\n","\n","    def forward(self, x):\n","        x = self.features(x)\n","        x = self.pool(x)\n","        x = self.classifier(x)\n","        return x\n","\n","\n","print(\"Code 12 통합본 실행 완료\")\n","print(\"필수 함수/클래스 준비 완료\")"],"execution_count":13,"outputs":[{"output_type":"stream","name":"stdout","text":["Code 12 통합본 실행 완료\n","필수 함수/클래스 준비 완료\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 16 : Random Search 2차 설정\n","# Grid Search 최고 조합 주변만 탐색\n","# =====================================================\n","\n","import random\n","import numpy as np\n","import pandas as pd\n","\n","# Grid Search 최고 성능\n","BASELINE_ACCURACY = 0.931844\n","\n","# Random Search 2차 실험 횟수\n","N_TRIALS = 6\n","\n","# 결과 재현용 시드\n","RANDOM_SEED = 42\n","\n","random.seed(RANDOM_SEED)\n","np.random.seed(RANDOM_SEED)\n","\n","SEARCH_SPACE = {\n","    \"n_mels_choices\": [64],\n","    \"duration_choices\": [5],\n","    \"learning_rate_min\": 1e-4,\n","    \"learning_rate_max\": 1e-3,\n","    \"n_fft_choices\": [2048, 4096],\n","    \"hop_length_choices\": [256, 512],\n","    \"batch_size_choices\": [16, 32]\n","}\n","\n","used_random_combinations = set()\n","\n","print(\"Random Search 2차 설정 완료\")\n","print(f\"실험 횟수 : {N_TRIALS}\")\n","print(f\"기준 Accuracy : {BASELINE_ACCURACY*100:.2f}%\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"IV6j6P1dh4eZ","executionInfo":{"status":"ok","timestamp":1781072348268,"user_tz":-540,"elapsed":10,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"9a8269da-a33f-4df6-9f24-afd289fc0e03"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Random Search 2차 설정 완료\n","실험 횟수 : 6\n","기준 Accuracy : 93.18%\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 17 : 랜덤 하이퍼파라미터 생성 함수\n","# =====================================================\n","\n","def generate_random_params():\n","\n","    while True:\n","\n","        n_mels = random.choice(SEARCH_SPACE[\"n_mels_choices\"])\n","        duration = random.choice(SEARCH_SPACE[\"duration_choices\"])\n","\n","        learning_rate = random.uniform(\n","            SEARCH_SPACE[\"learning_rate_min\"],\n","            SEARCH_SPACE[\"learning_rate_max\"]\n","        )\n","\n","        n_fft = random.choice(SEARCH_SPACE[\"n_fft_choices\"])\n","        hop_length = random.choice(SEARCH_SPACE[\"hop_length_choices\"])\n","        batch_size = random.choice(SEARCH_SPACE[\"batch_size_choices\"])\n","\n","        params_key = (\n","            n_mels,\n","            duration,\n","            n_fft,\n","            hop_length,\n","            batch_size,\n","            round(learning_rate, 6)\n","        )\n","\n","        if params_key not in used_random_combinations:\n","\n","            used_random_combinations.add(params_key)\n","\n","            return {\n","                \"n_mels\": n_mels,\n","                \"duration\": duration,\n","                \"n_fft\": n_fft,\n","                \"hop_length\": hop_length,\n","                \"batch_size\": batch_size,\n","                \"learning_rate\": learning_rate\n","            }\n","\n","\n","sample_params = generate_random_params()\n","\n","print(\"랜덤 생성 결과\")\n","print(sample_params)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qogd1qhYiKUZ","executionInfo":{"status":"ok","timestamp":1781072349793,"user_tz":-540,"elapsed":5,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"dd50617c-1c7b-45a1-d166-175af39b510a"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["랜덤 생성 결과\n","{'n_mels': 64, 'duration': 5, 'n_fft': 2048, 'hop_length': 256, 'batch_size': 16, 'learning_rate': 0.0007673954497838496}\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 18 : Random Search용 실험 함수\n","# 데이터 생성 → 학습 → 평가 → 모델 저장 → 결과 반환\n","# =====================================================\n","\n","import os\n","import torch\n","import pandas as pd\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","def run_random_experiment(params):\n","\n","    print(\"\\n=====================================================\")\n","    print(\"Random Search Experiment\")\n","    print(\"=====================================================\")\n","    print(params)\n","\n","    n_mels = params[\"n_mels\"]\n","    duration = params[\"duration\"]\n","    n_fft = params[\"n_fft\"]\n","    hop_length = params[\"hop_length\"]\n","    batch_size = params[\"batch_size\"]\n","    learning_rate = params[\"learning_rate\"]\n","\n","    SAMPLE_RATE = 22050\n","    SAMPLES_SEG = SAMPLE_RATE * duration\n","    CLASSES = ['Cargo', 'Passengership', 'Tanker', 'Tug']\n","    BASE_PATH = '/content/deepship/DeepShip-main'\n","\n","    X, y = [], []\n","\n","    for label, cls in enumerate(CLASSES):\n","        folder = f'{BASE_PATH}/{cls}'\n","\n","        for fname in os.listdir(folder):\n","            if not fname.endswith('.wav'):\n","                continue\n","\n","            audio, sr = librosa.load(f'{folder}/{fname}', sr=SAMPLE_RATE)\n","\n","            if len(audio) < SAMPLES_SEG:\n","                continue\n","\n","            for start in range(0, len(audio) - SAMPLES_SEG + 1, SAMPLES_SEG):\n","                chunk = audio[start:start + SAMPLES_SEG]\n","\n","                X.append(make_mel(chunk, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                X.append(make_mel(add_noise(chunk), sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                stretched = fix_length(\n","                    time_stretch(chunk, rate=1.1),\n","                    SAMPLES_SEG\n","                )\n","\n","                X.append(make_mel(stretched, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                shifted = pitch_shift(chunk, sr, n_steps=2)\n","\n","                X.append(make_mel(shifted, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","    if not X:\n","        print(\"데이터가 생성되지 않았습니다.\")\n","        return None\n","\n","    X_np = np.array(X)\n","    y_np = np.array(y)\n","\n","    print(f\"총 데이터 수 : {len(X_np)}개\")\n","    print(f\"스펙트로그램 크기 : {X_np[0].shape}\")\n","\n","    X_train, X_test, y_train, y_test = train_test_split(\n","        X_np,\n","        y_np,\n","        test_size=0.2,\n","        random_state=42,\n","        stratify=y_np\n","    )\n","\n","    train_loader = DataLoader(\n","        ShipDataset(X_train, y_train),\n","        batch_size=batch_size,\n","        shuffle=True\n","    )\n","\n","    test_loader = DataLoader(\n","        ShipDataset(X_test, y_test),\n","        batch_size=batch_size\n","    )\n","\n","    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model = ShipCNN().to(device)\n","\n","    optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)\n","    criterion = nn.CrossEntropyLoss()\n","\n","    EPOCHS = 20\n","\n","    for epoch in range(EPOCHS):\n","        model.train()\n","        total_loss = 0\n","\n","        for X_batch, y_batch in train_loader:\n","            X_batch = X_batch.to(device)\n","            y_batch = y_batch.to(device)\n","\n","            optimizer.zero_grad()\n","            outputs = model(X_batch)\n","            loss = criterion(outputs, y_batch)\n","            loss.backward()\n","            optimizer.step()\n","\n","            total_loss += loss.item()\n","\n","        if (epoch + 1) % 10 == 0 or epoch == EPOCHS - 1:\n","            model.eval()\n","            correct = 0\n","\n","            with torch.no_grad():\n","                for X_batch, y_batch in test_loader:\n","                    X_batch = X_batch.to(device)\n","                    y_batch = y_batch.to(device)\n","\n","                    preds = model(X_batch).argmax(1)\n","                    correct += (preds == y_batch).sum().item()\n","\n","            acc = correct / len(X_test)\n","\n","            print(\n","                f\"Epoch {epoch+1}: \"\n","                f\"Loss={total_loss/len(train_loader):.4f}, \"\n","                f\"Accuracy={acc*100:.2f}%\"\n","            )\n","\n","    model.eval()\n","    y_pred, y_true = [], []\n","\n","    with torch.no_grad():\n","        for X_batch, y_batch in test_loader:\n","            X_batch = X_batch.to(device)\n","            y_batch = y_batch.to(device)\n","\n","            outputs = model(X_batch)\n","            predicted = outputs.argmax(1)\n","\n","            y_pred.extend(predicted.cpu().numpy())\n","            y_true.extend(y_batch.cpu().numpy())\n","\n","    report = classification_report(\n","        y_true,\n","        y_pred,\n","        target_names=CLASSES,\n","        output_dict=True\n","    )\n","\n","    cm = confusion_matrix(y_true, y_pred)\n","\n","    accuracy = report[\"accuracy\"]\n","    macro_f1 = report[\"macro avg\"][\"f1-score\"]\n","    weighted_f1 = report[\"weighted avg\"][\"f1-score\"]\n","\n","    print(\"\\n최종 결과\")\n","    print(f\"Accuracy    : {accuracy:.4f} ({accuracy*100:.2f}%)\")\n","    print(f\"Macro F1    : {macro_f1:.4f}\")\n","    print(f\"Weighted F1 : {weighted_f1:.4f}\")\n","\n","    model_path = (\n","        f\"{MODEL_DIR}/\"\n","        f\"acc_{accuracy:.4f}_\"\n","        f\"macrof1_{macro_f1:.4f}_\"\n","        f\"nmel_{n_mels}_\"\n","        f\"dur_{duration}_\"\n","        f\"batch_{batch_size}.pth\"\n","    )\n","\n","    torch.save(model.state_dict(), mode