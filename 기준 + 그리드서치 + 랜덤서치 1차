["#코드 10\n","\n","from sklearn.metrics import classification_report, confusion_matrix\n","import seaborn as sns\n","import matplotlib.pyplot as plt\n","\n","model.eval()\n","y_pred = []\n","y_true = []\n","with torch.no_grad():\n","    for X_batch, y_batch in test_loader:\n","        X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n","        outputs = model(X_batch)\n","        _, predicted = torch.max(outputs.data, 1)\n","        y_pred.extend(predicted.cpu().numpy())\n","        y_true.extend(y_batch.cpu().numpy())\n","\n","print(\"\\nClassification Report:\")\n","print(classification_report(y_true, y_pred, target_names=CLASSES))\n","\n","cm = confusion_matrix(y_true, y_pred)\n","plt.figure(figsize=(8, 6))\n","sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=CLASSES, yticklabels=CLASSES)\n","plt.xlabel('Predicted')\n","plt.ylabel('True')\n","plt.title('Confusion Matrix')\n","plt.show()"],"execution_count":21,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Classification Report:\n","               precision    recall  f1-score   support\n","\n","        Cargo       0.82      0.97      0.89       180\n","Passengership       0.96      0.79      0.86        84\n","       Tanker       0.94      0.75      0.83       119\n","          Tug       0.88      1.00      0.94        46\n","\n","     accuracy                           0.88       429\n","    macro avg       0.90      0.88      0.88       429\n"," weighted avg       0.89      0.88      0.87       429\n","\n"]},{"output_type":"display_data","data":{"text/plain":["<Figure size 800x600 with 2 Axes>"],"image/png":"\n"},"metadata":{}}]},{"cell_type":"markdown","metadata":{"id":"4f1a44c1"},"source":["## 하이퍼파라미터 튜닝\n","멜 스펙트로그램 생성 및 오디오 세그먼트 길이에 대한 다양한 하이퍼파라미터 조합을 탐색하여 최적의 모델 성능을 찾아보겠습니다. 다음 파라미터들을 조합하여 실험을 진행합니다:\n","\n","- `n_mels`: 멜 스펙트로그램의 멜 필터 뱅크 개수 (64, 128, 256)\n","- `duration`: 오디오 세그먼트 길이 (5, 10, 15 초)\n","- `n_fft`: FFT 윈도우 크기 (1024, 2048, 4096)\n","- `hop_length`: FFT 홉 길이 (256, 512)\n","\n","각 조합에 대해 데이터 전처리, 모델 학습 및 평가를 수행하고, 그 결과를 비교합니다."]},{"cell_type":"code","metadata":{"id":"aadd9a78","executionInfo":{"status":"ok","timestamp":1781067833872,"user_tz":-540,"elapsed":2,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}}},"source":["#코드 11\n","\n","# 튜닝할 하이퍼파라미터 정의\n","param_grid = {\n","    'n_mels': [64, 128, 256],\n","    'duration': [5, 10, 15], # seconds\n","    'n_fft': [1024, 2048, 4096],\n","    'hop_length': [256, 512]\n","}\n","\n","all_results = []"],"execution_count":13,"outputs":[]},{"cell_type":"code","metadata":{"id":"af729e93","executionInfo":{"status":"ok","timestamp":1781068334047,"user_tz":-540,"elapsed":16,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}}},"source":["# =====================================================\n","# 코드 12 : Random Search 필수 함수/클래스 통합본\n","# 런타임 초기화 후 이 셀만 다시 실행하면 됨\n","# =====================================================\n","\n","import os\n","import gc\n","import random\n","import numpy as np\n","import pandas as pd\n","import librosa\n","\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","# -----------------------------------------------------\n","# 기본 경로\n","# -----------------------------------------------------\n","\n","SAVE_ROOT = \"/content/drive/MyDrive/DeepShip_Results\"\n","MODEL_DIR = f\"{SAVE_ROOT}/models\"\n","CSV_DIR = f\"{SAVE_ROOT}/csv\"\n","CHECKPOINT_DIR = f\"{SAVE_ROOT}/checkpoints\"\n","\n","os.makedirs(SAVE_ROOT, exist_ok=True)\n","os.makedirs(MODEL_DIR, exist_ok=True)\n","os.makedirs(CSV_DIR, exist_ok=True)\n","os.makedirs(CHECKPOINT_DIR, exist_ok=True)\n","\n","BASE_PATH = \"/content/deepship/DeepShip-main\"\n","CLASSES = [\"Cargo\", \"Passengership\", \"Tanker\", \"Tug\"]\n","SAMPLE_RATE = 22050\n","\n","# -----------------------------------------------------\n","# 데이터 증강 함수\n","# -----------------------------------------------------\n","\n","def add_noise(y, noise_level=0.005):\n","    noise = np.random.randn(len(y))\n","    return y + noise_level * noise\n","\n","\n","def time_stretch(y, rate=1.1):\n","    return librosa.effects.time_stretch(y=y, rate=rate)\n","\n","\n","def pitch_shift(y, sr, n_steps=2):\n","    return librosa.effects.pitch_shift(y=y, sr=sr, n_steps=n_steps)\n","\n","\n","def fix_length(y, target_length):\n","    if len(y) > target_length:\n","        return y[:target_length]\n","    return np.pad(y, (0, target_length - len(y)))\n","\n","\n","# -----------------------------------------------------\n","# Mel Spectrogram 함수\n","# -----------------------------------------------------\n","\n","def make_mel(y, sr, n_mels, n_fft, hop_length):\n","    mel = librosa.feature.melspectrogram(\n","        y=y,\n","        sr=sr,\n","        n_mels=n_mels,\n","        n_fft=n_fft,\n","        hop_length=hop_length\n","    )\n","\n","    mel_db = librosa.power_to_db(mel, ref=np.max)\n","\n","    return mel_db\n","\n","\n","# -----------------------------------------------------\n","# Dataset 클래스\n","# -----------------------------------------------------\n","\n","class ShipDataset(Dataset):\n","\n","    def __init__(self, X, y):\n","        self.X = torch.FloatTensor(X).unsqueeze(1)\n","        self.y = torch.LongTensor(y)\n","\n","    def __len__(self):\n","        return len(self.X)\n","\n","    def __getitem__(self, idx):\n","        return self.X[idx], self.y[idx]\n","\n","\n","# -----------------------------------------------------\n","# CNN 모델\n","# -----------------------------------------------------\n","\n","class ShipCNN(nn.Module):\n","\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.features = nn.Sequential(\n","            nn.Conv2d(1, 32, 3, padding=1),\n","            nn.BatchNorm2d(32),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.2),\n","\n","            nn.Conv2d(32, 64, 3, padding=1),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3),\n","\n","            nn.Conv2d(64, 128, 3, padding=1),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3)\n","        )\n","\n","        self.pool = nn.AdaptiveAvgPool2d((4, 4))\n","\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(128 * 4 * 4, 256),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(256, len(CLASSES))\n","        )\n","\n","    def forward(self, x):\n","        x = self.features(x)\n","        x = self.pool(x)\n","        x = self.classifier(x)\n","        return x\n","\n","\n","print(\"Code 12 통합본 실행 완료\")\n","print(\"필수 함수/클래스 준비 완료\")"],"execution_count":26,"outputs":[]},{"cell_type":"code","metadata":{"id":"1c03ae5a","executionInfo":{"status":"ok","timestamp":1781068335732,"user_tz":-540,"elapsed":36,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}}},"source":["#코드 13\n","\n","# Dataset 클래스 (이전과 동일)\n","class ShipDataset(Dataset):\n","    def __init__(self, X, y):\n","        self.X = torch.FloatTensor(X).unsqueeze(1)\n","        self.y = torch.LongTensor(y)\n","    def __len__(self):\n","        return len(self.X)\n","    def __getitem__(self, idx):\n","        return self.X[idx], self.y[idx]\n","\n","# CNN 모델 (이전과 동일)\n","class ShipCNN(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","        self.features = nn.Sequential(\n","            nn.Conv2d(1, 32, 3, padding=1), nn.BatchNorm2d(32), nn.ReLU(),\n","            nn.MaxPool2d(2), nn.Dropout2d(0.25),\n","            nn.Conv2d(32, 64, 3, padding=1), nn.BatchNorm2d(64), nn.ReLU(),\n","            nn.MaxPool2d(2), nn.Dropout2d(0.25),\n","            nn.Conv2d(64, 128, 3, padding=1), nn.BatchNorm2d(128), nn.ReLU(),\n","            nn.MaxPool2d(2), nn.Dropout2d(0.25),\n","        )\n","        self.classifier = nn.Sequential(\n","            nn.AdaptiveAvgPool2d((4, 4)),\n","            nn.Flatten(),\n","            nn.Linear(128 * 4 * 4, 256), nn.ReLU(), nn.Dropout(0.5),\n","            nn.Linear(256, 4)\n","        )\n","    def forward(self, x):\n","        return self.classifier(self.features(x))"],"execution_count":27,"outputs":[]},{"cell_type":"code","metadata":{"id":"9c0ddbdb"},"source":["#코드 14\n","\n","def run_experiment(n_mels, duration, n_fft, hop_length):\n","    print(f\"\\n--- Experimenting with N_MELS={n_mels}, Duration={duration}s, N_FFT={n_fft}, Hop_Length={hop_length} ---\")\n","\n","    SAMPLE_RATE = 22050\n","    SEGMENT = duration\n","    SAMPLES_SEG = SAMPLE_RATE * SEGMENT\n","    CLASSES = ['Cargo', 'Passengership', 'Tanker', 'Tug']\n","    BASE_PATH = '/content/deepship/DeepShip-main' # Assuming archive.zip was extracted here\n","\n","    X, y = [], []\n","\n","    for label, cls in enumerate(CLASSES):\n","        folder = f'{BASE_PATH}/{cls}'\n","        for fname in os.listdir(folder):\n","            if not fname.endswith('.wav'):\n","                continue\n","\n","            audio, sr = librosa.load(f'{folder}/{fname}', sr=SAMPLE_RATE)\n","\n","            # Ensure audio is long enough for at least one segment\n","            if len(audio) < SAMPLES_SEG:\n","                print(f\"Skipping {fname}: audio length ({len(audio)}) less than segment length ({SAMPLES_SEG})\")\n","                continue\n","\n","            for start in range(0, len(audio) - SAMPLES_SEG + 1, SAMPLES_SEG):\n","                chunk = audio[start:start + SAMPLES_SEG]\n","\n","                # Original mel spectrogram\n","                X.append(make_mel(chunk, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                # Augmented data\n","                X.append(make_mel(add_noise(chunk), sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                # time_stretch 결과의 길이를 고정\n","                stretched = fix_length(time_stretch(chunk, rate=1.1, n_fft=n_fft, hop_length=hop_length), SAMPLES_SEG)\n","                X.append(make_mel(stretched, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                X.append(make_mel(pitch_shift(chunk, sr, n_steps=2), sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","    if not X:\n","        print(f\"No data generated for N_MELS={n_mels}, Duration={duration}s, N_FFT={n_fft}, Hop_Length={hop_length}. Skipping experiment.\")\n","        return None, None\n","\n","    X_np = np.array(X)\n","    y_np = np.array(y)\n","\n","    print(f\"총 데이터 수: {len(X_np)}개\")\n","    if len(X_np) > 0:\n","        print(f\"스펙트로그램 크기: {X_np[0].shape}\")\n","    else:\n","        print(\"데이터가 생성되지 않았습니다.\")\n","        return None, None\n","\n","    X_train, X_test, y_train, y_test = train_test_split(\n","        X_np, y_np, test_size=0.2, random_state=42, stratify=y_np\n","    )\n","\n","    train_loader = DataLoader(ShipDataset(X_train, y_train), batch_size=16, shuffle=True)\n","    test_loader = DataLoader(ShipDataset(X_test, y_test), batch_size=16)\n","\n","    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model = ShipCNN().to(device)\n","    optimizer = torch.optim.Adam(model.parameters(), lr=0.001)\n","    criterion = nn.CrossEntropyLoss()\n","\n","    EPOCHS = 30 # Reduce epochs for faster grid search\n","\n","    for epoch in range(EPOCHS):\n","        model.train()\n","        total_loss = 0\n","        for X_batch, y_batch in train_loader:\n","            X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n","            optimizer.zero_grad()\n","            loss = criterion(model(X_batch), y_batch)\n","            loss.backward()\n","            optimizer.step()\n","            total_loss += loss.item()\n","\n","        if (epoch + 1) % 10 == 0 or epoch == EPOCHS - 1:\n","            model.eval()\n","            correct = 0\n","            with torch.no_grad():\n","                for X_batch, y_batch in test_loader:\n","                    X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n","                    correct += (model(X_batch).argmax(1) == y_batch).sum().item()\n","            acc = correct / len(X_test) * 100\n","            print(f\"  Epoch {epoch+1}: Loss={total_loss/len(train_loader):.4f}, 정확도={acc:.1f}%\")\n","\n","    model.eval()\n","    y_pred = []\n","    y_true = []\n","    with torch.no_grad():\n","        for X_batch, y_batch in test_loader:\n","            X_batch, y_batch = X_batch.to(device), y_batch.to(device)\n","            outputs = model(X_batch)\n","            _, predicted = torch.max(outputs.data, 1)\n","            y_pred.extend(predicted.cpu().numpy())\n","            y_true.extend(y_batch.cpu().numpy())\n","\n","    report = classification_report(y_true, y_pred, target_names=CLASSES, output_dict=True)\n","    accuracy = report['accuracy']\n","    print(f\"  Final Test Accuracy: {accuracy:.4f}\")\n","\n","    return accuracy, report"],"execution_count":null,"outputs":[]},{"cell_type":"code","metadata":{"id":"daa73b42","colab":{"base_uri":"https://localhost:8080/","height":1000},"executionInfo":{"status":"error","timestamp":1780896717341,"user_tz":-540,"elapsed":6040950,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"f4d968d7-a55b-4c52-dfdf-50d01e6b4519"},"source":["#코드 15\n","\n","# 하이퍼파라미터 그리드 탐색 실행\n","# SAMPLE_RATE는 전역 변수처럼 사용되므로, 이 스크립트의 상단에서 정의된 값을 재사용합니다.\n","# (혹은 run_experiment 함수 내부에서 정의된 SAMPLE_RATE를 사용합니다.)\n","# 여기서는 run_experiment 내부의 정의를 따르므로, SAMPLE_RATE = 22050 으로 고정됩니다.\n","\n","for n_mels_val in param_grid['n_mels']:\n","    for duration_val in param_grid['duration']:\n","        for n_fft_val in param_grid['n_fft']:\