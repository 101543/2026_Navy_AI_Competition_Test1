dom_combinations:\n","\n","            used_random_combinations.add(params_key)\n","\n","            return {\n","                \"n_mels\": n_mels,\n","                \"duration\": duration,\n","                \"n_fft\": n_fft,\n","                \"hop_length\": hop_length,\n","                \"batch_size\": batch_size,\n","                \"learning_rate\": learning_rate\n","            }\n","\n","\n","sample_params = generate_random_params()\n","\n","print(\"랜덤 생성 결과\")\n","print(sample_params)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"qogd1qhYiKUZ","executionInfo":{"status":"ok","timestamp":1781068350240,"user_tz":-540,"elapsed":5,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"fb97d4da-44f5-430a-83b6-736d1828d0de"},"execution_count":29,"outputs":[{"output_type":"stream","name":"stdout","text":["랜덤 생성 결과\n","{'n_mels': 256, 'duration': 5, 'n_fft': 2048, 'hop_length': 128, 'batch_size': 8, 'learning_rate': 0.00017253119014573414}\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 18 : Random Search용 실험 함수\n","# 데이터 생성 → 학습 → 평가 → 모델 저장 → 결과 반환\n","# =====================================================\n","\n","import os\n","import torch\n","import pandas as pd\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","def run_random_experiment(params):\n","\n","    print(\"\\n=====================================================\")\n","    print(\"Random Search Experiment\")\n","    print(\"=====================================================\")\n","    print(params)\n","\n","    n_mels = params[\"n_mels\"]\n","    duration = params[\"duration\"]\n","    n_fft = params[\"n_fft\"]\n","    hop_length = params[\"hop_length\"]\n","    batch_size = params[\"batch_size\"]\n","    learning_rate = params[\"learning_rate\"]\n","\n","    SAMPLE_RATE = 22050\n","    SAMPLES_SEG = SAMPLE_RATE * duration\n","    CLASSES = ['Cargo', 'Passengership', 'Tanker', 'Tug']\n","    BASE_PATH = '/content/deepship/DeepShip-main'\n","\n","    X, y = [], []\n","\n","    for label, cls in enumerate(CLASSES):\n","        folder = f'{BASE_PATH}/{cls}'\n","\n","        for fname in os.listdir(folder):\n","            if not fname.endswith('.wav'):\n","                continue\n","\n","            audio, sr = librosa.load(f'{folder}/{fname}', sr=SAMPLE_RATE)\n","\n","            if len(audio) < SAMPLES_SEG:\n","                continue\n","\n","            for start in range(0, len(audio) - SAMPLES_SEG + 1, SAMPLES_SEG):\n","                chunk = audio[start:start + SAMPLES_SEG]\n","\n","                X.append(make_mel(chunk, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                X.append(make_mel(add_noise(chunk), sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                stretched = fix_length(\n","                    time_stretch(chunk, rate=1.1),\n","                    SAMPLES_SEG\n","                )\n","\n","                X.append(make_mel(stretched, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","                shifted = pitch_shift(chunk, sr, n_steps=2)\n","\n","                X.append(make_mel(shifted, sr, n_mels, n_fft, hop_length))\n","                y.append(label)\n","\n","    if not X:\n","        print(\"데이터가 생성되지 않았습니다.\")\n","        return None\n","\n","    X_np = np.array(X)\n","    y_np = np.array(y)\n","\n","    print(f\"총 데이터 수 : {len(X_np)}개\")\n","    print(f\"스펙트로그램 크기 : {X_np[0].shape}\")\n","\n","    X_train, X_test, y_train, y_test = train_test_split(\n","        X_np,\n","        y_np,\n","        test_size=0.2,\n","        random_state=42,\n","        stratify=y_np\n","    )\n","\n","    train_loader = DataLoader(\n","        ShipDataset(X_train, y_train),\n","        batch_size=batch_size,\n","        shuffle=True\n","    )\n","\n","    test_loader = DataLoader(\n","        ShipDataset(X_test, y_test),\n","        batch_size=batch_size\n","    )\n","\n","    device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n","    model = ShipCNN().to(device)\n","\n","    optimizer = torch.optim.Adam(model.parameters(), lr=learning_rate)\n","    criterion = nn.CrossEntropyLoss()\n","\n","    EPOCHS = 20\n","\n","    for epoch in range(EPOCHS):\n","        model.train()\n","        total_loss = 0\n","\n","        for X_batch, y_batch in train_loader:\n","            X_batch = X_batch.to(device)\n","            y_batch = y_batch.to(device)\n","\n","            optimizer.zero_grad()\n","            outputs = model(X_batch)\n","            loss = criterion(outputs, y_batch)\n","            loss.backward()\n","            optimizer.step()\n","\n","            total_loss += loss.item()\n","\n","        if (epoch + 1) % 10 == 0 or epoch == EPOCHS - 1:\n","            model.eval()\n","            correct = 0\n","\n","            with torch.no_grad():\n","                for X_batch, y_batch in test_loader:\n","                    X_batch = X_batch.to(device)\n","                    y_batch = y_batch.to(device)\n","\n","                    preds = model(X_batch).argmax(1)\n","                    correct += (preds == y_batch).sum().item()\n","\n","            acc = correct / len(X_test)\n","\n","            print(\n","                f\"Epoch {epoch+1}: \"\n","                f\"Loss={total_loss/len(train_loader):.4f}, \"\n","                f\"Accuracy={acc*100:.2f}%\"\n","            )\n","\n","    model.eval()\n","    y_pred, y_true = [], []\n","\n","    with torch.no_grad():\n","        for X_batch, y_batch in test_loader:\n","            X_batch = X_batch.to(device)\n","            y_batch = y_batch.to(device)\n","\n","            outputs = model(X_batch)\n","            predicted = outputs.argmax(1)\n","\n","            y_pred.extend(predicted.cpu().numpy())\n","            y_true.extend(y_batch.cpu().numpy())\n","\n","    report = classi