af729e93","executionInfo":{"status":"ok","timestamp":1781074864670,"user_tz":-540,"elapsed":9700,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"colab":{"base_uri":"https://localhost:8080/"},"outputId":"320f4337-194c-4285-a712-1a3357303f81"},"source":["# =====================================================\n","# 코드 12 : Random Search 필수 함수/클래스 통합본\n","# 런타임 초기화 후 이 셀만 다시 실행하면 됨\n","# =====================================================\n","\n","import os\n","import gc\n","import random\n","import numpy as np\n","import pandas as pd\n","import librosa\n","\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.model_selection import train_test_split\n","from sklearn.metrics import classification_report, confusion_matrix\n","\n","# -----------------------------------------------------\n","# 기본 경로\n","# -----------------------------------------------------\n","\n","SAVE_ROOT = \"/content/drive/MyDrive/DeepShip_Results\"\n","MODEL_DIR = f\"{SAVE_ROOT}/models\"\n","CSV_DIR = f\"{SAVE_ROOT}/csv\"\n","CHECKPOINT_DIR = f\"{SAVE_ROOT}/checkpoints\"\n","\n","os.makedirs(SAVE_ROOT, exist_ok=True)\n","os.makedirs(MODEL_DIR, exist_ok=True)\n","os.makedirs(CSV_DIR, exist_ok=True)\n","os.makedirs(CHECKPOINT_DIR, exist_ok=True)\n","\n","BASE_PATH = \"/content/deepship/DeepShip-main\"\n","CLASSES = [\"Cargo\", \"Passengership\", \"Tanker\", \"Tug\"]\n","SAMPLE_RATE = 22050\n","\n","# -----------------------------------------------------\n","# 데이터 증강 함수\n","# -----------------------------------------------------\n","\n","def add_noise(y, noise_level=0.005):\n","    noise = np.random.randn(len(y))\n","    return y + noise_level * noise\n","\n","\n","def time_stretch(y, rate=1.1):\n","    return librosa.effects.time_stretch(y=y, rate=rate)\n","\n","\n","def pitch_shift(y, sr, n_steps=2):\n","    return librosa.effects.pitch_shift(y=y, sr=sr, n_steps=n_steps)\n","\n","\n","def fix_length(y, target_length):\n","    if len(y) > target_length:\n","        return y[:target_length]\n","    return np.pad(y, (0, target_length - len(y)))\n","\n","\n","# -----------------------------------------------------\n","# Mel Spectrogram 함수\n","# -----------------------------------------------------\n","\n","def make_mel(y, sr, n_mels, n_fft, hop_length):\n","    mel = librosa.feature.melspectrogram(\n","        y=y,\n","        sr=sr,\n","        n_mels=n_mels,\n","        n_fft=n_fft,\n","        hop_length=hop_length\n","    )\n","\n","    mel_db = librosa.power_to_db(mel, ref=np.max)\n","\n","    return mel_db\n","\n","\n","# -----------------------------------------------------\n","# Dataset 클래스\n","# -----------------------------------------------------\n","\n","class ShipDataset(Dataset):\n","\n","    def __init__(self, X, y):\n","        self.X = torch.FloatTensor(X).unsqueeze(1)\n","        self.y = torch.LongTensor(y)\n","\n","    def __len__(self):\n","        return len(self.X)\n","\n","    def __getitem__(self, idx):\n","        return self.X[idx], self.y[idx]\n","\n","\n","# -----------------------------------------------------\n","# CNN 모델\n","# -----------------------------------------------------\n","\n","class ShipCNN(nn.Module):\n","\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.features = nn.Sequential(\n","            nn.Conv2d(1, 32, 3, padding=1),\n","            nn.BatchNorm2d(32),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.2),\n","\n","            nn.Conv2d(32, 64, 3, padding=1),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3),\n","\n","            nn.Conv2d(64, 128, 3, padding=1),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(),\n","            nn.MaxPool2d(2),\n","            nn.Dropout2d(0.3)\n","        )\n","\n","        self.pool = nn.AdaptiveAvgPool2d((4, 4))\n","\n","        self.classifier = nn.Sequential(\n","            nn.Flatten(),\n","            nn.Linear(128 * 4 * 4, 256),\n","            nn.ReLU(),\n","            nn.Dropout(0.5),\n","            nn.Linear(256, len(CLASSES))\n","        )\n","\n","    def forward(self, x):\n","        x = self.features(x)\n","        x = self.pool(x)\n","        x = self.classifier(x)\n","        return x\n","\n","\n","print(\"Code 12 통합본 실행 완료\")\n","print(\"필수 함수/클래스 준비 완료\")"],"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Code 12 통합본 실행 완료\n","필수 함수/클래스 준비 완료\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 22 : Epoch Search 설정\n","# Grid 최고 vs Random 최고\n","# =====================================================\n","\n","\n","# 후보 A : Grid Search 최고\n","\n","GRID_PARAMS = {\n","    \"name\": \"GRID\",\n","    \"n_mels\": 64,\n","    \"duration\": 5,\n","    \"n_fft\": 4096,\n","    \"hop_length\": 256,\n","    \"batch_size\": 16,\n","    \"learning_rate\": 0.001\n","}\n","\n","\n","# 후보 B : Random Search 최고\n","\n","RANDOM_PARAMS = {\n","    \"name\": \"RANDOM\",\n","    \"n_mels\": 64,\n","    \"duration\": 5,\n","    \"n_fft\": 4096,\n","    \"hop_length\": 512,\n","    \"batch_size\": 16,\n","    \"learning_rate\": 0.0004231844453795309\n","}\n","\n","\n","# 비교 대상\n","\n","PARAM_CANDIDATES = [\n","    GRID_PARAMS,\n","    RANDOM_PARAMS\n","]\n","\n","\n","# Epoch 비교\n","\n","EPOCH_LIST = [20, 30, 50]\n","\n","\n","# 결과 저장\n","\n","epoch_results = []\n","\n","print(\"Epoch Search 설정 완료\")\n","print()\n","\n","print(\"비교 대상\")\n","\n","for p in PARAM_CANDIDATES:\n","\n","    print(\"-\" * 50)\n","\n","    for k, v in p.items():\n","        print(f\"{k} : {v}\")\n","\n","print()\n","print(f\"비교할 Epoch : {EPOCH_LIST}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"PvDZakgHPHdu","executionInfo":{"status":"ok","timestamp":1781074868126,"user_tz":-540,"elapsed":3,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"f5062afc-3ec1-41a9-93ff-4ff7e4719d4c"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Epoch Search 설정 완료\n","\n","비교 대상\n","--------------------------------------------------\n","name : GRID\n","n_mels : 64\n","duration : 5\n","n_fft : 4096\n","hop_length : 256\n","batch_size : 16\n","learning_rate : 0.001\n","--------------------------------------------------\n","name : RANDOM\n","n_mels : 64\n","duration : 5\n","n_fft : 4096\n","hop_length : 512\n","batch_size : 16\n","learning_rate : 0.0004231844453795309\n","\n","비교할 Epoch : [20, 30, 50]\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 23 : 데이터 생성\n","# =====================================================\n","\n","prepared_data = {}\n","\n","for params in PARAM_CANDIDATES:\n","\n","    print()\n","    print(f\"{params['name']} 데이터 생성 시작\")\n","\n","    n_mels = params[\"n_mels\"]\n","    duration = params[\"duration\"]\n","    n_fft = params[\"n_fft\"]\n","    hop_length = params[\"hop_length\"]\n","\n","    samples_seg = SAMPLE_RATE * duration\n","\n","    X = []\n","    y = []\n","\n","    for label, cls in enumerate(CLASSES):\n","\n","        folder = f\"{BASE_PATH}/{cls}\"\n","\n","        for fname in os.listdir(folder):\n","\n","            if not fname.endswith(\".wav\"):\n","                continue\n","\n","            audio, sr = librosa.load(\n","                f\"{folder}/{fname}\",\n","                sr=SAMPLE_RATE\n","            )\n","\n","            if len(audio) < samples_seg:\n","                continue\n","\n","            for start in range(\n","                0,\n","                len(audio) - samples_seg + 1,\n","                samples_seg\n","            ):\n","\n","                chunk = audio[start:start + samples_seg]\n","\n","                X.append(\n","                    make_mel(\n","                        chunk,\n","                        sr,\n","                        n_mels,\n","                        n_fft,\n","                        hop_length\n","                    )\n","                )\n","                y.append(label)\n","\n","                X.append(\n","                    make_mel(\n","                        add_noise(chunk),\n","                        sr,\n","                        n_mels,\n","                        n_fft,\n","                        hop_length\n","                    )\n","                )\n","                y.append(label)\n","\n","                stretched = fix_length(\n","                    time_stretch(chunk),\n","                    samples_seg\n","                )\n","\n","                X.append(\n","                    make_mel(\n","                        stretched,\n","                        sr,\n","                        n_mels,\n","                        n_fft,\n","                        hop_length\n","                    )\n","                )\n","                y.append(label)\n","\n","                shifted = pitch_shift(\n","                    chunk,\n","                    sr,\n","                    n_steps=2\n","                )\n","\n","                X.append(\n","                    make_mel(\n","                        shifted,\n","                        sr,\n","                        n_mels,\n","                        n_fft,\n","                        hop_length\n","                    )\n","                )\n","                y.append(label)\n","\n","    X_np = np.array(X)\n","    y_np = np.array(y)\n","\n","    prepared_data[params[\"name\"]] = {\n","        \"params\": params,\n","        \"X\": X_np,\n","        \"y\": y_np\n","    }\n","\n","    print(f\"{params['name']} 완료\")\n","    print(f\"데이터 수 : {len(X_np)}\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"mvaDFUw9Plmx","executionInfo":{"status":"ok","timestamp":1781075329967,"user_tz":-540,"elapsed":458781,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"7e5bd9b7-c212-458b-b4a1-b15b86a88d91"},"execution_count":4,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","GRID 데이터 생성 시작\n","GRID 완료\n","데이터 수 : 4472\n","\n","RANDOM 데이터 생성 시작\n","RANDOM 완료\n","데이터 수 : 4472\n"]}]},{"cell_type":"code","source":["# =====================================================\n","# 코드 24 : Epoch Search 실행\n","# =====================================================\n","\n","csv_path = f\"{CSV_DIR}/epoch_search_results.csv\"\n","\n","if os.path.exists(csv_path):\n","\n","    existing_df = pd.read_csv(csv_path)\n","\n","    print(f\"기존 결과 {len(existing_df)}개 발견\")\n","\n","else:\n","\n","    existing_df = pd.DataFrame()\n","\n","    print(\"기존 결과 없음\")\n","\n","\n","for model_name, data in prepared_data.items():\n","\n","    params = data[\"params\"]\n","\n","    X_np = data[\"X\"]\n","    y_np = data[\"y\"]\n","\n","    for epochs in EPOCH_LIST:\n","\n","        already_done = False\n","\n","        if len(existing_df) > 0:\n","\n","            match = existing_df[\n","                (existing_df[\"name\"] == model_name) &\n","                (existing_df[\"epochs\"] == epochs)\n","            ]\n","\n","            if len(match) > 0:\n","                already_done = True\n","\n","        if already_done:\n","\n","            print(\n","                f\"건너뜀 : \"\n","                f\"{model_name} Epoch {epochs}\"\n","            )\n","\n","            continue\n","\n","        print()\n","        print(\"=\" * 60)\n","        print(f\"{model_name} | Epoch {epochs}\")\n","        print(\"=\" * 60)\n","\n","        X_train, X_test, y_train, y_test = train_test_split(\n","            X_np,\n","            y_np,\n","            test_size=0.2,\n","            random_state=42,\n","            stratify=y_np\n","        )\n","\n","        train_loader = DataLoader(\n","            ShipDataset(X_train, y_train),\n","            batch_size=params[\"batch_size\"],\n","            shuffle=True\n","        )\n","\n","        test_loader = DataLoader(\n","            ShipDataset(X_test, y_test),\n","            batch_size=params[\"batch_size\"]\n","        )\n","\n","        device = torch.device(\n","            \"cuda\" if torch.cuda.is_available() else \"cpu\"\n","        )\n","\n","        model = ShipCNN().to(device)\n","\n","        optimizer = torch.optim.Adam(\n","            model.parameters(),\n","            lr=params[\"learning_rate\"]\n","        )\n","\n","        criterion = nn.CrossEntropyLoss()\n","\n","        for epoch in range(epochs):\n","\n","            model.train()\n","\n","            for X_batch, y_batch in train_loader:\n","\n","                X_batch = X_batch.to(device)\n","                y_batch = y_batch.to(device)\n","\n","                optimizer.zero_grad()\n","\n","                outputs = model(X_batch)\n","\n","                loss = criterion(outputs, y_batch)\n","\n","                loss.backward()\n","\n","                optimizer.step()\n","\n","        model.eval()\n","\n","        y_pred = []\n","        y_true = []\n","\n","        with torch.no_grad():\n","\n","            for X_batch, y_batch in test_loader:\n","\n","                X_batch = X_batch.to(device)\n","                y_batch = y_batch.to(device)\n","\n","                outputs = model(X_batch)\n","\n","                predicted = outputs.argmax(1)\n","\n","                y_pred.extend(\n","                    predicted.cpu().numpy()\n","                )\n","\n","                y_true.extend(\n","                    y_batch.cpu().numpy()\n","                )\n","\n","        report = classification_report(\n","            y_true,\n","            y_pred,\n","            target_names=CLASSES,\n","            output_dict=True\n","        )\n","\n","        result = {\n","            \"name\": model_name,\n","            \"epochs\": epochs,\n","            \"accuracy\": report[\"accuracy\"],\n","            \"macro_f1\": report[\"macro avg\"][\"f1-score\"],\n","            \"weighted_f1\": report[\"weighted avg\"][\"f1-score\"]\n","        }\n","\n","        new_row = pd.DataFrame([result])\n","\n","        existing_df = pd.concat(\n","            [existing_df, new_row],\n","            ignore_index=True\n","        )\n","\n","        existing_df.to_csv(\n","            csv_path,\n","            index=False\n","        )\n","\n","        print(\n","            f\"Accuracy : \"\n","            f\"{report['accuracy']:.4f}\"\n","        )\n","\n","        del model\n","\n","        gc.collect()\n","\n","        if torch.cuda.is_available():\n","            torch.cuda.empty_cache()\n","\n","print()\n","print(\"Epoch Search 완료\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"1uuuug6TPsx2","executionInfo":{"status":"ok","timestamp":1781076007523,"user_tz":-540,"elapsed":669448,"user":{"displayName":"sanguk kim","userId":"09135379298595078027"}},"outputId":"5ad44a78-0318-49f8-90d4-a337ee21a4ad"},"execution_count":5,"outputs":[{"output_type":"stream","name":"stdout","text":["기존 결과 없음\n","\n","============================================================\n","GRID | Epoch 20\n","============================================================\n","Accuracy : 0.8559\n","\n","============================================================\n","GRID | Epoch 30\n","============================================================\n","Accuracy : 0.9095\n","\n","============================================================\n","GRID | Epoch 50\n","============================================================\n","Accuracy : 0.9397\n","\n","============================================================\n","RANDOM | Epoch 20\n","============================================================\n","Accuracy : 0.8592\n","\n","============================================================\n","RANDOM | Epoch 30\n","===============================================